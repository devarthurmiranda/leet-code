   "source": [
    "class Solution:\n",
    "    def isPalindrome(self, x: int) -> bool:\n",
    "        if x < 0:\n",
    "            return False\n",
    "        string = str(x)\n",
    "        return string == string[::-1]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
