   "source": [
    "class Solution:\n",
    "    def twoSum(self, nums: List[int], target: int) -> List[int]:\n",
    "        idx = {}  # value -> index\n",
    "        for i, a in enumerate(nums):\n",
    "            b = target - a\n",
    "            if b in idx:\n",
    "                return [idx[b], i]\n",
    "            idx[a] = i"
   ]
